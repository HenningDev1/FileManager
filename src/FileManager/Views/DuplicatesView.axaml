<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:FileManager.Models"
             xmlns:c="using:FileManager.Controls"
             x:Class="FileManager.Views.DuplicatesView">
  <Border Classes="card" Margin="0,0,0,8">
    <DockPanel Margin="20,18,20,10">
      <StackPanel DockPanel.Dock="Top" Spacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="Duplicate Finder" Classes="title" />
          <TextBlock TextWrapping="Wrap" Classes="sub"
                     Text="Finds files with identical content — including copies named like photo_1.jpg, photo (2).jpg or photo - Copy.jpg. Nothing is ever deleted automatically." />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="RootButton" Click="Root_Click" Margin="0,0,8,6" MaxWidth="320">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Ico Kind="folder" />
              <TextBlock x:Name="RootText" TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </StackPanel>
          </Button>
          <ComboBox x:Name="MinSizeBox" SelectedIndex="1" Margin="0,0,8,6" MinWidth="150">
            <ComboBoxItem>Any size</ComboBoxItem>
            <ComboBoxItem>Larger than 100 KB</ComboBoxItem>
            <ComboBoxItem>Larger than 1 MB</ComboBoxItem>
            <ComboBoxItem>Larger than 10 MB</ComboBoxItem>
            <ComboBoxItem>Larger than 100 MB</ComboBoxItem>
          </ComboBox>
          <CheckBox x:Name="NameMatchBox" Content="Also show _1 / (2) / Copy names with different content" Margin="4,0,12,6" />
          <CheckBox x:Name="HiddenBox" Content="Include hidden" Margin="0,0,12,6" />
          <Button x:Name="ScanButton" Classes="accent" Content="Scan" MinWidth="90" Click="Scan_Click" Margin="0,0,0,6" HorizontalContentAlignment="Center" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" Classes="sub" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ProgressBar Grid.Column="1" x:Name="Busy" IsIndeterminate="True" Width="120" Height="4" IsVisible="False" />
        </Grid>

        <Border x:Name="SummaryBar" IsVisible="False" CornerRadius="10" Padding="12,8" Background="{DynamicResource ControlBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock x:Name="SummaryText" FontWeight="SemiBold" />
              <TextBlock x:Name="SelectionText" Classes="sub" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Select suggested" Click="SelectSuggested_Click" ToolTip.Tip="Checks every copy except the one suggested to keep" />
              <Button Content="Select none" Click="SelectNone_Click" />
              <Button x:Name="DeleteButton" Classes="danger" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Ico Kind="trash" />
                  <TextBlock Text="Move selected to Recycle Bin" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <ListBox x:Name="List" Classes="plain" Margin="-8,10,-8,0">
        <ListBox.DataTemplates>
          <DataTemplate DataType="m:DupHeader" x:DataType="m:DupHeader">
            <StackPanel Margin="0,10,0,2" Spacing="1">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Classes="sub" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="m:DupEntry" x:DataType="m:DupEntry">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,90,Auto" Background="Transparent">
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,4,0" IsCheckedChanged="Check_Changed" />
              <Image Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="sub" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Reason}" /><Run Text="  ·  " /><Run Text="{Binding Folder}" />
                </TextBlock>
              </StackPanel>
              <Border Grid.Column="3" Classes="pill" IsVisible="{Binding IsKeeper}" Margin="8,0">
                <TextBlock Text="Keep" />
              </Border>
              <TextBlock Grid.Column="4" Text="{Binding SizeText}" Classes="sub" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Classes="tb" Tag="{Binding FullPath}" Click="Open_Click" ToolTip.Tip="Open"><c:Ico Kind="external" /></Button>
                <Button Classes="tb" Tag="{Binding FullPath}" Click="Reveal_Click" ToolTip.Tip="Show in folder"><c:Ico Kind="folder" /></Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
