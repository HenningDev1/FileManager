<Project>
  <!-- Shared settings for every project under src/. All build output goes to /artifacts. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\artifacts</ArtifactsPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Company>HenningDev1</Company>
    <Copyright>Copyright © 2026 HenningDev1</Copyright>
    <AvaloniaVersion>11.3.2</AvaloniaVersion>
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>
</Project>
