<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FileManager.Controls"
        xmlns:v="using:FileManager.Views"
        x:Class="FileManager.MainWindow"
        Title="File Manager" Width="1340" Height="840" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <LayoutTransformControl x:Name="ScaleHost">
  <Grid x:Name="RootGrid" ColumnDefinitions="236,*">

    <!-- ================= Sidebar ================= -->
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="60" Background="Transparent" PointerPressed="Drag_PointerPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,8,0,0" VerticalAlignment="Center">
            <Image x:Name="AppIconImage" Width="26" Height="26" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="File Manager" Classes="header" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button DockPanel.Dock="Bottom" Classes="side" Margin="10,4,10,12" Click="Settings_Click">
          <Grid ColumnDefinitions="Auto,*">
            <c:Ico Kind="settings" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SidebarPanel" Margin="10,0,10,8" Spacing="1" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ================= Main ================= -->
    <Grid Grid.Column="1" RowDefinitions="60,*,30">

      <!-- Toolbar (also the window title bar) -->
      <Border Background="Transparent" PointerPressed="Drag_PointerPressed">
        <Grid x:Name="ToolbarGrid" ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,12,148,6" VerticalAlignment="Center">
          <StackPanel x:Name="NavGroup" Orientation="Horizontal" Spacing="2">
            <Button Classes="tb" x:Name="BackBtn" ToolTip.Tip="Back (Alt+←)" Click="Back_Click"><c:Ico Kind="back" /></Button>
            <Button Classes="tb" x:Name="FwdBtn" ToolTip.Tip="Forward (Alt+→)" Click="Forward_Click"><c:Ico Kind="forward" /></Button>
            <Button Classes="tb" x:Name="UpBtn" ToolTip.Tip="Up (Backspace)" Click="Up_Click"><c:Ico Kind="up" /></Button>
            <Button Classes="tb" ToolTip.Tip="Refresh (F5)" Tag="refresh" Click="Cmd_Click"><c:Ico Kind="refresh" /></Button>
          </StackPanel>

          <StackPanel Grid.Column="1" x:Name="ActionGroup" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
            <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="4,0,6,0" />
            <Button Classes="tb" Tag="newfolder" Click="Cmd_Click" ToolTip.Tip="New folder (Ctrl+Shift+N)"><c:Ico Kind="folderplus" /></Button>
            <Button Classes="tb" Tag="cut" Click="Cmd_Click" ToolTip.Tip="Cut (Ctrl+X)"><c:Ico Kind="cut" /></Button>
            <Button Classes="tb" Tag="copy" Click="Cmd_Click" ToolTip.Tip="Copy (Ctrl+C)"><c:Ico Kind="copy" /></Button>
            <Button Classes="tb" Tag="paste" Click="Cmd_Click" ToolTip.Tip="Paste (Ctrl+V)"><c:Ico Kind="paste" /></Button>
            <Button Classes="tb" Tag="rename" Click="Cmd_Click" ToolTip.Tip="Rename (F2)"><c:Ico Kind="rename" /></Button>
            <Button Classes="tb" Tag="batchrename" Click="Cmd_Click" ToolTip.Tip="Batch rename (Ctrl+R)"><c:Ico Kind="batch" /></Button>
            <Button Classes="tb" Tag="zip" Click="Cmd_Click" ToolTip.Tip="Compress to ZIP"><c:Ico Kind="zip" /></Button>
            <Button Classes="tb" Tag="delete" Click="Cmd_Click" ToolTip.Tip="Move to Recycle Bin (Del)"><c:Ico Kind="trash" /></Button>
          </StackPanel>

          <TextBlock Grid.Column="2" x:Name="ViewTitle" Classes="header" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
            <StackPanel x:Name="ViewGroup" Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="tb" x:Name="ListToggle" ToolTip.Tip="List view" Click="ListMode_Click"><c:Ico Kind="list" /></ToggleButton>
              <ToggleButton Classes="tb" x:Name="GridToggle" ToolTip.Tip="Icon view" Click="GridMode_Click"><c:Ico Kind="grid" /></ToggleButton>
              <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="4,0" />
              <ToggleButton Classes="tb" x:Name="DualToggle" ToolTip.Tip="Dual pane (F6)" Click="Dual_Click"><c:Ico Kind="dual" /></ToggleButton>
              <ToggleButton Classes="tb" x:Name="PreviewToggle" ToolTip.Tip="Preview panel (Ctrl+P)" Click="Preview_Click"><c:Ico Kind="preview" /></ToggleButton>
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="240" Margin="8,0,0,0" Watermark="Filter · Enter = deep search"
                     KeyDown="Search_KeyDown" TextChanged="Search_TextChanged">
              <TextBox.InnerLeftContent>
                <c:Ico Kind="search" Margin="10,0,0,0" Opacity="0.55" />
              </TextBox.InnerLeftContent>
            </TextBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Content -->
      <Panel Grid.Row="1" Margin="12,0,12,0">
        <Grid x:Name="BrowserGrid" ColumnDefinitions="*,0,0,10,300">
          <v:FilePane x:Name="Pane1" Grid.Column="0" />
          <GridSplitter x:Name="Split1" Grid.Column="1" ResizeDirection="Columns" IsVisible="False" />
          <v:FilePane x:Name="Pane2" Grid.Column="2" IsVisible="False" />
          <GridSplitter x:Name="Split2" Grid.Column="3" ResizeDirection="Columns" />
          <v:PreviewPanel x:Name="Preview" Grid.Column="4" />
        </Grid>

        <ContentControl x:Name="ToolHost" IsVisible="False" />

        <!-- Floating batch bar -->
        <Border x:Name="BatchBar" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Padding="6" CornerRadius="14" Background="{DynamicResource ElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" BoxShadow="0 8 30 0 #33000000">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock x:Name="BatchText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0" />
            <Button Classes="tb" Tag="copy" Click="Cmd_Click" ToolTip.Tip="Copy"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="copy" /><TextBlock Text="Copy" /></StackPanel></Button>
            <Button Classes="tb" Tag="cut" Click="Cmd_Click" ToolTip.Tip="Cut"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="cut" /><TextBlock Text="Cut" /></StackPanel></Button>
            <Button Classes="tb" Tag="copyother" Click="Cmd_Click" ToolTip.Tip="Copy to the other pane"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="dual" /><TextBlock Text="Copy →" /></StackPanel></Button>
            <Button Classes="tb" Tag="moveother" Click="Cmd_Click" ToolTip.Tip="Move to the other pane"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="move" /><TextBlock Text="Move →" /></StackPanel></Button>
            <Button Classes="tb" Tag="batchrename" Click="Cmd_Click" ToolTip.Tip="Rename all selected"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="batch" /><TextBlock Text="Rename" /></StackPanel></Button>
            <Button Classes="tb" Tag="zip" Click="Cmd_Click" ToolTip.Tip="Compress to ZIP"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="zip" /><TextBlock Text="Zip" /></StackPanel></Button>
            <Button Classes="tb" Tag="delete" Click="Cmd_Click" ToolTip.Tip="Move to Recycle Bin"><StackPanel Orientation="Horizontal" Spacing="6"><c:Ico Kind="trash" Foreground="#FF3B30" /><TextBlock Text="Delete" /></StackPanel></Button>
            <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="2,0" />
            <Button Classes="tb" Tag="clearsel" Click="Cmd_Click" ToolTip.Tip="Clear selection"><c:Ico Kind="x" /></Button>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Status bar -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="18,0,18,6">
        <TextBlock x:Name="StatusText" Classes="sub" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" x:Name="StatusRight" Classes="sub" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>
